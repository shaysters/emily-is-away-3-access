<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Folder with Emily3.exe. Override with -p:GameDir="..." -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Emily is Away 3</GameDir>
    <Managed>$(GameDir)\Emily3_Data\Managed</Managed>
    <DeployDir>$(GameDir)\BepInEx\plugins\EmilyIsAway3Access</DeployDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Unity 2018.4, 32-bit, old Mono (.NET 3.5 profile). -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>EmilyIsAway3Access</AssemblyName>
    <RootNamespace>EmilyIsAway3Access</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Unity 2018's UnityEngine.dll facade names mscorlib 4.0, which makes MSBuild drop every
         game reference for net35. Don't follow references' own dependencies. -->
    <_FindDependencies>false</_FindDependencies>
    <!-- The test driver (TestDriver.cs) lives only in the private dev repo. -->
    <DevTools Condition="'$(DevTools)' == '' And Exists('TestDriver.cs')">true</DevTools>
    <DefineConstants Condition="'$(DevTools)' == 'true'">$(DefineConstants);DEV_TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(Managed)\UnityEngine.InputModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(Managed)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TextMeshPro"><HintPath>$(Managed)\TextMeshPro-2017.3-1.0.56-Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(Managed)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(Managed)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\prism\prism.dll" Link="prism.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\prism\LICENSE;..\..\prism\NOTICE" Link="Prism\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\prism\LICENSES\**\*" Link="Prism\LICENSES\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(DevTools)' != 'true'">
    <Compile Remove="TestDriver.cs" />
  </ItemGroup>

  <!-- Copy the build into the game's BepInEx plugins folder (skip with -p:SkipDeploy=true). -->
  <Target Name="Deploy" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\core') And '$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFiles="@(DeployFiles->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed to $(DeployDir)" />
  </Target>

</Project>
